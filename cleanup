#!/bin/sh
# Strips the diagnostic-suppression pragmas from the bundled OpenCL header
# (Khronos-vendored, guarded by #if defined(__clang__)/_MSC_VER blocks that
# never trigger on this package's GCC/Linux build, but present verbatim in
# the shipped source) -- R CMD check's pragma scan is textual, not
# compiler-aware, and flags "#pragma clang/warning diagnostic ..." wherever
# it appears regardless of the surrounding #ifdef guard.
set -e

cd "$(dirname "$0")"

CL_HEADER=src/math/lib/opencl_v2025.07.22/CL/cl_platform.h

if [ -f "$CL_HEADER" ]; then
  sed -i.bak \
    -e '/#pragma clang diagnostic/d' \
    -e '/#pragma warning( *push *)/d' \
    -e '/#pragma warning( *disable *:/d' \
    -e '/#pragma warning( *pop *)/d' \
    "$CL_HEADER"
  rm -f "$CL_HEADER.bak"
fi
