.PHONY: static package

PKG_CPPFLAGS = -I"../inst/include" -I"sundials" -include stan_sundials_printf_override.hpp -D_REENTRANT -DSTAN_THREADS -D_HAS_AUTO_PTR_ETC=0 -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS
PKG_CPPFLAGS += $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::CxxFlags()" | tail -n 1)

TBB_LIBS = $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::RcppParallelLibs()" | tail -n 1)

ifeq ($(OS),Windows_NT)
    TBB_CHECK = $(shell "${R_HOME}/bin/Rscript" -e "cat(utils::packageVersion('RcppParallel') > '6.0.0')")
	ifeq ($(TBB_CHECK),TRUE)
		TBB_LIBS = -ltbb12 -ltbbmalloc
	endif
endif

PKG_LIBS += $(TBB_LIBS)

SUNDIALS_CVODES := \
	$(wildcard math/lib/sundials_*/src/cvodes/*.c) \
	$(wildcard math/lib/sundials_*/src/sundials/*.c) \
	$(wildcard math/lib/sundials_*/src/sunmatrix/band/[^f]*.c) \
	$(wildcard math/lib/sundials_*/src/sunmatrix/dense/[^f]*.c) \
	$(wildcard math/lib/sundials_*/src/sunlinsol/band/[^f]*.c) \
	$(wildcard math/lib/sundials_*/src/sunlinsol/dense/[^f]*.c) \
	$(wildcard math/lib/sundials_*/src/sunnonlinsol/newton/[^f]*.c) \
	$(wildcard math/lib/sundials_*/src/sunnonlinsol/fixedpoint/[^f]*.c)

SUNDIALS_IDAS := \
	$(wildcard math/lib/sundials_*/src/idas/*.c)

SUNDIALS_KINSOL := \
	$(wildcard math/lib/sundials_*/src/kinsol/*.c)

SUNDIALS_NVECSERIAL := \
	$(wildcard math/lib/sundials_*/src/nvector/serial/nvector_serial.c)

SUNDIALS_SOURCES = $(SUNDIALS_CVODES) $(SUNDIALS_IDAS) $(SUNDIALS_KINSOL) $(SUNDIALS_NVECSERIAL)
SUNDIALS_OBJECTS = $(SUNDIALS_SOURCES:.c=.o)
OBJECTS = runner.o init.o model_methods.o r_data_context.o

$(SHLIB): static
$(OBJECTS): $(SUNDIALS_OBJECTS)
$(SUNDIALS_OBJECTS): package

package:
	@mkdir -p ../inst/include
	@cp -Rf stan/src/stan ../inst/include/stan
	@cp -Rf math/stan/. ../inst/include/stan
	@cp -Rf math/lib/sundials_*/include/* ../inst/include/
	@cp -Rf math/lib/sundials_*/src/sundials .
	@cp -Rf include/. ../inst/include/newstan

static: $(OBJECTS) $(SUNDIALS_OBJECTS)
	@mkdir -p ../inst/lib/$(R_ARCH)
	$(AR) -rs ../inst/lib/$(R_ARCH)/libnewstan_runner.a $(SUNDIALS_OBJECTS) runner.o model_methods.o r_data_context.o

clean:
	rm -rf ../inst/lib
	rm -f $(OBJECTS)
	rm -rf ../inst/include/
	rm -rf sundials
