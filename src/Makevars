PKG_CPPFLAGS = -I"../inst/include" -D_REENTRANT -DSTAN_THREADS -D_HAS_AUTO_PTR_ETC=0 -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS
PKG_CPPFLAGS += $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::CxxFlags()" | tail -n 1)

TBB_LIBS = $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::RcppParallelLibs()" | tail -n 1)

ifeq ($(OS),Windows_NT)
    TBB_CHECK = $(shell "${R_HOME}/bin/Rscript" -e "cat(utils::packageVersion('RcppParallel') > '6.0.0')")
	ifeq ($(TBB_CHECK),TRUE)
		TBB_LIBS = -ltbb12 -ltbbmalloc
	endif
endif

PKG_LIBS += $(TBB_LIBS)

DEV_RUNTIME_ARCHIVE = ../lib/libnewstan_runner.a
ifeq ($(strip $(R_PACKAGE_DIR)),)
RUNTIME_ARCHIVE = $(DEV_RUNTIME_ARCHIVE)
else
RUNTIME_ARCHIVE = $(R_PACKAGE_DIR)/lib$(R_ARCH)/libnewstan_runner.a
endif

RUNTIME_ARCHIVES = $(RUNTIME_ARCHIVE) $(DEV_RUNTIME_ARCHIVE)

$(SHLIB): $(RUNTIME_ARCHIVES)

$(RUNTIME_ARCHIVES): runner.o
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $<
