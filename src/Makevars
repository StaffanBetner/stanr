.PHONY: static package
CXX_STD = CXX20

PKG_CPPFLAGS = -I"../inst/include" -I"sundials" -include stan_sundials_printf_override.hpp -D_REENTRANT -DSTAN_THREADS -D_HAS_AUTO_PTR_ETC=0 -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS
PKG_CPPFLAGS += $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::CxxFlags()" | tail -n 1)

TBB_LIBS = $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::RcppParallelLibs()" | tail -n 1)

ifeq ($(OS),Windows_NT)
    TBB_CHECK = $(shell "${R_HOME}/bin/Rscript" -e "cat(utils::packageVersion('RcppParallel') >= '6.0.0')")
	ifeq ($(TBB_CHECK),TRUE)
		TBB_LIBS = -ltbb12 -ltbbmalloc
	endif
endif

PKG_LIBS += $(TBB_LIBS)

SUNDIALS_SOURCES = $(wildcard sundials/*.c)
SUNDIALS_OBJECTS = $(SUNDIALS_SOURCES:.c=.o)

RUNNER_OBJECTS = runner.o model_methods.o r_data_context.o
OBJECTS = init.o xptr.o

$(SHLIB): static
$(OBJECTS) $(RUNNER_OBJECTS): package
$(SUNDIALS_OBJECTS): | package

package:
	@cp -Rf walnutpie/include/. ../inst/include/

static: $(RUNNER_OBJECTS) $(SUNDIALS_OBJECTS)
	@mkdir -p ../inst/lib/$(R_ARCH)
	$(AR) -rs ../inst/lib/$(R_ARCH)/libstanr_runner.a $(SUNDIALS_OBJECTS) $(RUNNER_OBJECTS)
	@strip --strip-debug ../inst/lib/$(R_ARCH)/libstanr_runner.a || true

clean:
	rm -rf ../inst/lib
	rm -f $(OBJECTS) $(RUNNER_OBJECTS)
